<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.google.android.inputmethod.latin" /></queries>
    <application android:label="Myanmar KeyMap" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".MyanmarIme" android:label="Myanmar KeyMap" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method"/>
        </service>
        <service android:name=".ShortcutService" android:label="Myanmar KeyMap Shortcut Service" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/shortcut_service"/>
        </service>
    </application>
</manifest>
